{
  "name": "ecocide",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ecocide/web dev",
    "dev:all": "concurrently \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:web": "pnpm --filter @ecocide/web dev",
    "dev:server": "pnpm --filter @ecocide/server dev",
    "build": "pnpm --filter @ecocide/compliance build && pnpm --filter @ecocide/lore build && pnpm --filter @ecocide/types build && pnpm --filter @ecocide/server build && pnpm --filter @ecocide/web build",
    "test": "vitest run",
    "wireframes": "node scripts/wireframes.mjs",
    "scan-costs": "pnpm --filter @ecocide/server scan-costs",
    "bench": "pnpm --filter @ecocide/server bench",
    "bench:matrix": "pnpm bench --db=pglite --mode=offline && pnpm bench --db=postgres --mode=offline",
    "bench:report": "pnpm --filter @ecocide/server bench:report",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.64.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@10.32.1"
}
