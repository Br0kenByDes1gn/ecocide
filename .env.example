# Copy to `.env` and fill in what you need. Everything is optional for local dev:
# without GEMINI_API_KEY the server uses the offline simulation verdict; without
# SMTP the emails are logged (jsonTransport); without REDIS_URL jobs run inline.

# --- AI verdict engine ---
GEMINI_API_KEY=

# --- Job queue (BullMQ). Unset = inline in-process dispatcher ---
REDIS_URL=
BULL_BOARD_USER=
BULL_BOARD_PASS=

# --- Email (nodemailer). Unset SMTP_HOST = messages logged, not sent ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ecocide <no-reply@localhost>"
MAIL_REPLY_TO=

# --- Auth (Better Auth email-OTP Asset Vault) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
APP_BASE_URL=http://localhost:5173

# --- Misc ---
# Set to false to skip automatic migrations at boot.
AUTO_MIGRATE=true
# Default avatar synthesis engine id.
AVATAR_ENGINE=gemini-text-svg
