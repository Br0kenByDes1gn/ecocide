# Copy to `.env` and fill in what you need. Everything is optional for local dev:
# without GEMINI_API_KEY / Vertex AI creds the server uses the offline simulation
# verdict; without SMTP emails are logged (jsonTransport); without REDIS_URL jobs
# run inline.

# --- Database (PostgreSQL) ---
# Unset = PGlite: a full PostgreSQL compiled to WASM running in-process, stored
# in apps/server/data/pgdata. Local dev and tests need no server.
# Set it to talk to a real PostgreSQL — locally (docker run -e
# POSTGRES_PASSWORD=dev -p 5432:5432 postgres:17) or in production. The Cloud SQL
# unix socket form is:
#   postgres://user:pass@localhost/db?host=/cloudsql/PROJECT:REGION:INSTANCE
#DATABASE_URL=
# PGlite data directory (replaces the old SQLite file):
#PGLITE_DATA_DIR=./data/pgdata
#DB_POOL_MAX=10

# --- AI verdict engine ---
# Two billing paths, same SDK:
#  • GEMINI_API_KEY            → Gemini Developer API (AI Studio billing).
#  • Vertex AI (recommended)   → billed to your GCP project via Cloud billing;
#    set GEMINI_MODE=vertex + GEMINI_PROJECT + GCP_SA_KEY (inline service-account
#    JSON) or GOOGLE_APPLICATION_CREDENTIALS (file path) / ambient ADC.
# Mode is auto-detected when GEMINI_MODE is unset.
GEMINI_API_KEY=
#GEMINI_MODE=vertex
#GEMINI_PROJECT=your-gcp-project-id
#GEMINI_LOCATION=global   # default: global endpoint; use a regional one (e.g.
#                         # asia-southeast1, Singapore) once the models you use
#                         # are available there — 3.x models 404 on some regions
#GCP_SA_KEY=
#GEMINI_MODEL=gemini-3.8-flash

# --- Job queue (BullMQ). Unset = inline in-process dispatcher ---
REDIS_URL=
BULL_BOARD_USER=
BULL_BOARD_PASS=

# --- Email (nodemailer). Unset SMTP_HOST = messages logged, not sent ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ecocide <no-reply@localhost>"
MAIL_REPLY_TO=

# --- Auth (Better Auth email-OTP Asset Vault) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
APP_BASE_URL=http://localhost:5173

# --- Misc ---
# Set to false to skip automatic migrations at boot (production: the Cloud Run
# migrate job owns DDL, so it runs once per release instead of on every cold start).
AUTO_MIGRATE=true
# Where archived audit photos are stored as files (the DB keeps only the name).
# Defaults to apps/server/data/evidence. In production this is a mounted bucket.
#EVIDENCE_DIR=/app/evidence
