flowchart TB
  subgraph USERS["Users"]
    U["Citizens<br/>browser / PWA"]
  end

  subgraph DELIVERY["Delivery — keyless"]
    GHA["GitHub Actions<br/>build and publish the image ·<br/>run migrations · deploy"]
  end

  subgraph GCP["Google Cloud project"]
    EDGE["HTTPS<br/>custom domain, managed certificate"]
    subgraph SVC["Cloud Run service"]
      APP["One container running the API<br/>and the app together · scales to zero"]
    end
    MIG["Cloud Run job<br/>database migrations"]
    subgraph STATE["Managed state"]
      SQL[("Cloud SQL<br/>database")]
      GCS[("Cloud Storage<br/>evidence photos")]
    end
    SEC["Secret Manager"]
    VX["Vertex AI<br/>vision and text models"]
  end

  SMTP["Email relay (external)"]

  U --> EDGE
  EDGE --> APP
  APP --> SQL
  APP --> GCS
  APP --> SEC
  APP --> VX
  APP --> SMTP
  GHA -->|deploy| APP
  GHA -->|migrate| MIG
  MIG --> SQL

