# Template for the production configuration consumed by deploy/gcp/sync-env.sh.
#
#   cp deploy/gcp/env.production.example .env.production
#   $EDITOR .env.production
#   ./deploy/gcp/sync-env.sh            # dry run first — prints what would change
#   ./deploy/gcp/sync-env.sh --apply
#
# `.env.production` is gitignored (.env.*), and the file is loaded as shell, so
# QUOTE THE VALUES: single quotes for anything with spaces, '#' or '<…>'.
#
# The script decides where each key goes:
#   BETTER_AUTH_SECRET, SMTP_PASS  → Secret Manager (never plain env)
#   DATABASE_URL                   → Secret Manager (contains the DB password)
#   everything below               → plain service env
# An unrecognised key is a hard error rather than a silent plain-text env var.
#
# Deliberately NOT here: GEMINI_API_KEY / GCP_SA_KEY / GOOGLE_APPLICATION_CREDENTIALS.
# Vertex AI uses the runtime service account's ADC, and one of those would either
# switch the billing path or ship a long-lived credential. The script rejects them.
#
# REDIS_URL and BULL_BOARD_* are intentionally absent too: with no Redis the job
# dispatcher runs inline and Bull Board stays unmounted (no Memorystore to pay for).

# --- Runtime invariants ---
NODE_ENV=production
# The Cloud Run migrate job owns DDL (deploy/gcp/README.md), so boot migrations
# are off: schema changes run once per release instead of on every cold start.
AUTO_MIGRATE=false

# --- Public origin (must match what the browser is actually on) ---
# Deploy once on the *.run.app URL, map the domain, then set these. They feed
# Better Auth's trustedOrigins, so a mismatch breaks the registry with a
# confusing CORS error.
BETTER_AUTH_URL=https://ecocide.quest
APP_BASE_URL=https://ecocide.quest

# --- Database ---
# Leave DATABASE_URL out entirely: setup.sh already created the Cloud SQL socket
# DSN as the ecocide-db-url secret. Only set it to point production somewhere
# else, in the form:
#   postgres://USER:PASSWORD@localhost/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
#DATABASE_URL=

# --- Secrets (the values go to Secret Manager, which setup.sh pre-created) ---
# Generate with:  openssl rand -hex 32
# Required. Must be >= 32 chars; the script rejects the dev fallback.
BETTER_AUTH_SECRET=

# --- Email: Brevo SMTP (transactional email has no GCP first-party service) ---
# Without this the registry cannot issue OTPs, and production deliberately does
# not log the code.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
# Your Brevo LOGIN ADDRESS — not the From address.
SMTP_USER=
# A Brevo SMTP key (SMTP & API → SMTP → Generate a new SMTP key), NOT the API key.
# Shown once. A wrong value here fails the release smoke test.
SMTP_PASS=
MAIL_FROM='ECOCIDE <no-reply@ecocide.quest>'
# Leave empty unless you have a real mailbox: a reply-to that bounces hurts
# deliverability.
#MAIL_REPLY_TO=

# --- AI verdict engine (Vertex AI via the runtime service account's ADC) ---
GEMINI_MODE=vertex
GEMINI_PROJECT=ecocide-511407
# Keep `global`: regional Vertex endpoints do not serve the 3.x models.
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# --- Evidence store ---
# The mounted Cloud Storage bucket path in Cloud Run (override the image default
# /data/evidence). Audit photos stay files; the DB only stores the name.
EVIDENCE_DIR=/app/evidence
